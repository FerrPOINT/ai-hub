  "states": [
    {
      "id": "ready",
      "label": "Данные загружены",
      "rule": "Содержимое с as_of, confidence и count"
    },
    {
      "id": "loading",
      "label": "Загрузка",
      "rule": "Не отображать успешные нулевые деньги/пустой каталог"
    },
    {
      "id": "empty",
      "label": "Подтверждённый пустой результат",
      "rule": "Scope/filters сохранены; contextual action"
    },
    {
      "id": "error",
      "label": "Ошибка чтения",
      "rule": "Сохранить draft/last values; безопасный retry чтения"
    },
    {
      "id": "forbidden",
      "label": "Нет доступа",
      "rule": "Не logout; без CRUD/повторного model вызова"
    },
    {
      "id": "not_found",
      "label": "Нет объекта",
      "rule": "Не fallback на первый объект; никаких CRUD"
    },
    {
      "id": "partial",
      "label": "Часть источников недоступна",
      "rule": "Known/unknown раздельно; успешно загруженное сохранено"
    },
    {
      "id": "stale",
      "label": "Устаревший snapshot",
      "rule": "as_of/lag и обновление, не fake live"
    },
    {
      "id": "conflict",
      "label": "CAS конфликт 412",
      "rule": "Черновик не теряется; read current revision/explicit reconcile"
    },
    {
      "id": "pending",
      "label": "Операция в процессе",
      "rule": "No double submit; durable operation readback"
    },
    {
      "id": "budget_exhausted",
      "label": "Недостаточно бюджета",
      "rule": "Denied before external I/O; explain held reserve/scope"
    },
    {
      "id": "long",
      "label": "Длинные значения",
      "rule": "Реальные переносы, читаемые IDs, без body overflow"
    }
  ],
  "forms": {
    "connection": {
      "operation": "createConnection",
      "schema": "ConnectionInput",
      "fields": ["display_name", "endpoint_policy_ref", "billing_mode"],
      "derived": ["provider path kind"],
      "result": "Connection/draft; authorization separate"
    },
    "credential": {
      "operation": "writeCredential",
      "schema": "CredentialInput",
      "fields": ["secret"],
      "derived": ["expected_generation from exact connection"],
      "result": "Operation; no secret readback"
    },
    "profile": {
      "operation": "createVirtualModel",
      "schema": "ProfileInput",
      "fields": [
        "slug",
        "display_name",
        "mode",
        "deployments",
        "parameters",
        "input_limit",
        "output_limit",
        "context_limit",
        "required_capabilities",
        "allowed_overrides",
        "timeout_seconds",
        "max_attempts"
      ],
      "derived": [],
      "result": "Draft; proof not required for create/save"
    },
    "profileProof": {
      "operation": "verifyVirtualModelDraft",
      "schema": "ProfileVerificationInput",
      "fields": ["budget_policy_id"],
      "derived": ["expected_draft_version", "If-Match"],
      "result": "Own profile_draft proof, exact hash/deployments"
    },
    "publish": {
      "operation": "publishRevision",
      "schema": "PublishInput",
      "fields": [],
      "derived": [
        "expected_draft_version",
        "profile_verification_id",
        "If-Match"
      ],
      "result": "Immutable active revision + audit"
    },
    "price": {
      "operation": "createPriceRevision",
      "schema": "PriceInput",
      "fields": [
        "connection_id",
        "model_id",
        "tier",
        "currency",
        "input_uncached",
        "input_cached",
        "output_billable",
        "request_fee",
        "effective_from",
        "effective_to",
        "source"
      ],
      "derived": ["unit=per_million_tokens"],
      "result": "Immutable new rates; historical facts not rewritten"
    },
    "subscription": {
      "operation": "recordSubscription",
      "schema": "SubscriptionInput",
      "fields": [
        "connection_id",
        "period_start",
        "period_end",
        "amount",
        "currency",
        "payment_status",
        "receipt_ref"
      ],
      "derived": [],
      "result": "Metadata pending trust; body cannot assign confirmed charge"
    },
    "correction": {
      "operation": "requestLedgerCorrection",
      "schema": "CorrectionInput",
      "fields": ["original_entry_id", "trusted_receipt_ref", "reason"],
      "derived": ["Amount/trust from importer, not user"],
      "result": "Append-only correction/settlement"
    },
    "budget": {
      "operation": "createBudget",
      "schema": "BudgetInput",
      "fields": [
        "scope_type",
        "scope_id",
        "currency",
        "period",
        "hard_limit",
        "warning_thresholds"
      ],
      "derived": [],
      "result": "Policy + current canonical period"
    },
    "client": {
      "operation": "createClient",
      "schema": "ClientInput",
      "fields": [
        "application_key",
        "project_binding",
        "allowed_virtual_model_ids",
        "expires_at",
        "max_concurrency",
        "max_requests_per_minute",
        "scopes",
        "cost_policy",
        "namespace"
      ],
      "derived": [],
      "result": "Client metadata; issueClientKey explicit separate operation"
    },
    "dataset": {
      "operation": "createDatasetVersion",
      "schema": "DatasetInput",
      "fields": ["name", "project_binding", "cases", "namespace"],
      "derived": ["hash/version generated by owner"],
      "result": "Immutable dataset"
    },
    "evaluation": {
      "operation": "startEvaluation",
      "schema": "EvaluationInput",
      "fields": [
        "dataset_version_id",
        "profile_revision_ids",
        "repetitions",
        "max_concurrency",
        "budget_policy_id",
        "scorer_revision"
      ],
      "derived": ["actor/validated internal execution grant"],
      "result": "Frozen evaluation and own expenses"
    },
    "modelContext": {
      "operation": "saveModelContextPreference",
      "schema": "ModelContextPreferenceInput",
      "fields": ["model_id", "context_window_tokens"],
      "derived": ["connection_id", "If-Match"],
      "result": "Saved exact connection/model preference; not physical limit"
    },
    "pricingSource": {
      "operation": "createPricingSourceRevision",
      "schema": "PricingSourceInput",
      "fields": [
        "connection_id",
        "model_id",
        "mode",
        "manual_price_revision_id",
        "expected_version"
      ],
      "derived": ["expected_version CAS, exact verified identity"],
      "result": "New immutable revision; historical requests preserved"
    },
    "projectTariff": {
      "operation": "createProjectTariffRevision",
      "schema": "ProjectTariffInput",
      "fields": [
        "namespace",
        "virtual_model_id",
        "currency",
        "mode",
        "markup_bps",
        "input_uncached",
        "input_cached",
        "output_billable",
        "unit",
        "effective_from",
        "effective_to",
        "expected_version"
      ],
      "derived": ["expected_version CAS, exact verified identity"],
      "result": "New immutable revision; historical requests preserved"
