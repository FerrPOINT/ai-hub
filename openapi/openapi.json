  "components": {
    "schemas": {
      "Amount": {
        "type": "string"
      },
      "AuditEvent": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "action",
          "object_id",
          "operation_id",
          "happened_at"
        ],
        "properties": {
          "action": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "happened_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/NamespaceRef"
              }
            ]
          },
          "object_id": {
            "type": "string"
          },
          "operation_id": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": [
              "string",
              "null"
            ]
          },
          "revision": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "AuditPage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AuditEvent"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "BrandingContract": {
        "type": "object",
        "required": [
          "schema_version",
          "service_key",
          "central_branding_consumer",
          "local_fallback"
        ],
        "properties": {
          "central_branding_consumer": {
            "type": "boolean"
          },
          "local_fallback": {
            "type": "boolean"
          },
          "schema_version": {
            "type": "integer",
            "format": "int32",
            "minimum": 0
          },
          "service_key": {
            "type": "string"
          }
        }
      },
      "Currency": {
        "type": "string"
      },
      "Error": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "schema_revision": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "Identity": {
        "type": "object",
        "required": [
          "subject",
          "installation_id",
          "capabilities",
          "project_grants"
        ],
        "properties": {
          "capabilities": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "project_grants": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "subject": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "IntegrationStatus": {
        "type": "object",
        "required": [
          "service_key",
          "contract_version",
          "status",
          "source_revision",
          "base_revision"
        ],
        "properties": {
          "base_revision": {
            "type": "string"
          },
          "contract_version": {
            "type": "string"
          },
          "service_key": {
            "type": "string"
          },
          "source_revision": {
            "type": "string"
          },
          "status": {
            "type": "string"
          }
        }
      },
      "NamespaceBinding": {
        "type": "object",
        "required": [
          "namespace",
          "tracker_instance_id",
          "tracker_project_id",
          "state",
          "observed_at",
          "generation",
          "label",
          "tracker_project_key"
        ],
        "properties": {
          "generation": {
            "type": "integer",
            "format": "int64"
          },
          "label": {
            "type": "string"
          },
          "namespace": {
            "$ref": "#/components/schemas/NamespaceRef"
          },
          "observed_at": {
            "type": "string",
            "format": "date-time"
          },
          "state": {
            "type": "string"
          },
          "tracker_instance_id": {
            "type": "string",
            "format": "uuid"
          },
          "tracker_project_id": {
            "type": "string",
            "format": "uuid"
          },
          "tracker_project_key": {
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "NamespacePage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NamespaceBinding"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "NamespaceRef": {
        "type": "object",
        "required": [
          "registry_instance_id",
          "namespace_id"
        ],
        "properties": {
          "namespace_id": {
            "type": "string",
            "format": "uuid"
          },
          "registry_instance_id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "additionalProperties": false
      },
      "Operation": {
        "type": "object",
        "required": [
          "id",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "resource_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "safe_error": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "format": "int64"
          }
        },
        "additionalProperties": false
      },
      "PriceInput": {
        "type": "object",
        "required": [
          "connection_id",
          "model_id",
          "tier",
          "currency",
          "unit",
          "input_uncached",
          "input_cached",
          "output_billable",
          "effective_from",
          "effective_to",
          "source"
        ],
        "properties": {
          "connection_id": {
            "type": "string",
            "format": "uuid"
          },
          "currency": {
            "$ref": "#/components/schemas/Currency"
          },
          "effective_from": {
            "type": "string",
            "format": "date-time"
          },
          "effective_to": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "input_cached": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Rate"
              }
            ]
          },
          "input_uncached": {
            "$ref": "#/components/schemas/Rate"
          },
          "model_id": {
            "type": "string"
          },
          "output_billable": {
            "$ref": "#/components/schemas/Rate"
          },
          "request_fee": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/Amount",
                "description": "Missing fee stays unknown, never a default zero."
              }
            ]
          },
          "source": {
            "type": "string"
          },
          "tier": {
            "type": "string"
          },
          "unit": {
            "$ref": "#/components/schemas/PriceUnit"
          }
        },
        "additionalProperties": false
      },
      "PricePage": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PriceRevision"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "PriceRevision": {
        "type": "object",
        "required": [
          "id",
          "price",
          "created_at"
        ],
        "properties": {
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "price": {
            "$ref": "#/components/schemas/PriceInput"
          }
        }
      },
      "PriceUnit": {
        "type": "string",
        "enum": [
          "per_million_tokens"
        ]
      },
      "PublicConfig": {
        "type": "object",
        "required": [
          "auth_issuer",
          "oidc_client_id",
          "installation_id"
        ],
        "properties": {
          "auth_issuer": {
            "type": "string"
          },
          "branding_url": {
            "type": [
              "string",
              "null"
            ]
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "oidc_client_id": {
            "type": "string"
          },
          "service_catalog_url": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "Rate": {
        "type": "string"
      },
      "Version": {
        "type": "object",
        "required": [
          "service_key",
          "installation_id",
          "source_revision",
          "source_dirty",
          "base_revision",
          "namespace_base_revision",
          "external_calls",
          "schema_revision"
        ],
        "properties": {
          "base_revision": {
            "type": "string"
          },
          "external_calls": {
            "type": "boolean"
          },
          "installation_id": {
            "type": "string",
            "format": "uuid"
          },
          "namespace_base_revision": {
            "type": "string"
          },
          "schema_revision": {
            "type": "string"
          },
          "service_key": {
            "type": "string"
          },
          "source_dirty": {
            "type": "boolean"
          },
          "source_revision": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "CentralAuth": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
